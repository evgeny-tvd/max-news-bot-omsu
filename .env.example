# ─── max-news-bot-omsu: шаблон настроек ─────────────────────────────
# Скопируйте в .env и заполните (install.sh делает это за вас).
# .env содержит СЕКРЕТЫ — не коммитьте его в git!

# Обязательно:
MAX_BOT_TOKEN=          # токен бота MAX (создайте бота в MAX и скопируйте токен)
TARGET_CHAT_ID=         # ID канала, куда репостить. Не знаете? Добавьте бота
                        # в канал и напишите ему /start — он ответит «📢 Этот чат: …»

# Источник 1 — VK-паблик (можно оставить пустым, если не нужен):
VK_DOMAIN=              # напр. gorodtavda (без vk.com/)
VK_TOKEN=               # сервисный ключ: dev.vk.ru → мини-приложение → Ключи доступа
NEWS_INTERVAL=60        # сек, как часто опрашивать стену VK

# Источник 2 — публичный канал MAX (можно оставить пустым):
RSCH_CHAT_ID=           # ID канала-источника (напр. РСЧС вашего региона)
RSCH_INTERVAL=60        # сек, как часто опрашивать канал

# Режим доставки:
POLLING=true            # true: Long Polling (по умолчанию, ничего не нужно);
                        # false: webhook (нужны WEBHOOK_URL и WEBHOOK_SECRET)

# Только для POLLING=false:
# WEBHOOK_URL=https://bot.example.com/webhook
# WEBHOOK_SECRET=       # любой длинный секрет (openssl rand -hex 32)

# Прочее:
TZ=Asia/Yekaterinburg   # часовой пояс для /time и /date
# STATE_DIR=/data       # куда писать state (в Docker не менять)
